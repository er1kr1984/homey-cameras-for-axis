{
  "name": {
    "en": "Camera analytics"
  },
  "height": 420,
  "settings": [
    {
      "id": "camera",
      "type": "autocomplete",
      "title": {
        "en": "Camera"
      },
      "hint": {
        "en": "The camera to show, with what its analytics see."
      }
    },
    {
      "id": "boxes",
      "type": "checkbox",
      "title": {
        "en": "Draw boxes around people and vehicles"
      },
      "value": true,
      "hint": {
        "en": "Only on cameras that send scene metadata. With AXIS Object Analytics the boxes say what it is (person, car, …) and its colours; some newer cameras without it show plain 'moving object' boxes; older cameras (for example AXIS OS 9.80) send no boxes at all."
      }
    },
    {
      "id": "quality",
      "type": "dropdown",
      "title": {
        "en": "Video quality"
      },
      "value": "low",
      "values": [
        {
          "id": "low",
          "title": {
            "en": "Low (recommended)"
          }
        },
        {
          "id": "medium",
          "title": {
            "en": "Medium"
          }
        },
        {
          "id": "auto",
          "title": {
            "en": "Automatic"
          }
        }
      ]
    }
  ],
  "api": {
    "state": {
      "method": "POST",
      "path": "/state"
    },
    "scene": {
      "method": "POST",
      "path": "/scene"
    },
    "snapshot": {
      "method": "POST",
      "path": "/snapshot"
    },
    "offer": {
      "method": "POST",
      "path": "/offer"
    }
  }
}
