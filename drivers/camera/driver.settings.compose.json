        "id": "model",
        "type": "label",
        "label": {
          "en": "Model"
        },
        "value": ""
      },
      {
        "id": "serial",
        "type": "label",
        "label": {
          "en": "Serial number"
        },
        "value": ""
      },
      {
        "id": "firmware",
        "type": "label",
        "label": {
          "en": "AXIS OS"
        },
        "value": ""
