{
  "id": "com.erikrichardson.axis",
  "version": "1.0.3",
  "compatibility": ">=12.7.0",
  "runtime": "nodejs",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "brandColor": "#f2b705",
  "name": {
    "en": "Cameras for AXIS"
  },
  "description": {
    "en": "Live video, motion and analytics from your AXIS cameras, straight from each camera."
  },
  "category": [
    "security"
  ],
  "tags": {
    "en": [
      "axis",
      "camera",
      "vapix",
      "live video",
      "motion",
      "object analytics",
      "ptz"
    ]
  },
  "permissions": [],
  "author": {
    "name": "Erik Richardson",
    "email": "er1kr1984@gmail.com"
  },
  "api": {
    "getSettingsState": {
      "method": "GET",
      "path": "/settings"
    },
    "setDiagnostics": {
      "method": "POST",
      "path": "/diagnostics"
    },
    "getLogs": {
      "method": "GET",
      "path": "/logs"
    },
    "getPreviousLogs": {
      "method": "GET",
      "path": "/previous-logs"
    },
    "getCameraFeatures": {
      "method": "GET",
      "path": "/features"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "source": "https://github.com/er1kr1984/homey-cameras-for-axis",
  "bugs": {
    "url": "https://github.com/er1kr1984/homey-cameras-for-axis/issues"
  }
}
